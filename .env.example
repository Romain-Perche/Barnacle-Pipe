# Copy to .env.local for local runs. No real secrets here: put them in .env.local (git-ignored)
# or in Vercel's environment settings.

# development | test | production. Only exactly "development" or "test" enables the fake Google
# login and the fake data command.
APP_ENV=development

# Local Postgres. Tests use a separate database, e.g. postgres://postgres@localhost:5432/crm_test
DATABASE_URL=postgres://postgres@localhost:5432/crm_dev

# barnacle.ai address of the first admin. Signs in once to create their admin account.
FIRST_ADMIN_EMAIL=ada@barnacle.ai

# Real Google sign-in only (Internal OAuth app in the barnacle.ai Workspace). Not needed with the fake login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# File storage (SF-116): Supabase Storage. Leave SUPABASE_URL empty locally: with APP_ENV development or test the app
# then uses its fake storage (contents in .fake-storage/). SUPABASE_SECRET_KEY is a secret (server only): put it in
# .env.local or Vercel's settings, never here. FILES_BUCKET is the private bucket's name.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FILES_BUCKET=crm-files

# VERCEL_ENV is set by Vercel (production | preview | development). Do not set it locally.
