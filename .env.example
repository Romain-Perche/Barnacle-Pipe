# Copy to .env.local for local runs. No real secrets here: put them in .env.local (git-ignored)
# or in Vercel's environment settings.

# development | test | production. Only exactly "development" or "test" enables the fake Google
# login and the fake data command.
APP_ENV=development

# Local Postgres. Tests use a separate database, e.g. postgres://postgres@localhost:5432/crm_test
DATABASE_URL=postgres://postgres@localhost:5432/crm_dev

# barnacle.ai address of the first admin. Signs in once to create their admin account.
FIRST_ADMIN_EMAIL=ada@barnacle.ai

# Real Google sign-in only (Internal OAuth app in the barnacle.ai Workspace). Not needed with the fake login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# File storage (SF-116): Supabase Storage. Leave SUPABASE_URL empty locally: with APP_ENV development or test the app
# then uses its fake storage (contents in .fake-storage/). SUPABASE_SECRET_KEY is a secret (server only): put it in
# .env.local or Vercel's settings, never here. FILES_BUCKET is the private bucket's name.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FILES_BUCKET=crm-files

# Pipedrive import (SF-117). PIPEDRIVE_TOKEN_KEY is a secret (server only): 32 random bytes in base64, made with
# `openssl rand -base64 32`; put it in .env.local or Vercel's settings, never here. It encrypts the Pipedrive tokens
# users save; without it Settings says "The Pipedrive import isn't set up yet." Changing it makes saved tokens unreadable
# (users then save them again). Leave PIPEDRIVE_URL empty: with APP_ENV development or test the app then uses its fake
# Pipedrive (tokens fake-pipedrive-token and fake-pipedrive-other); elsewhere it uses https://api.pipedrive.com.
PIPEDRIVE_TOKEN_KEY=
PIPEDRIVE_URL=

# Gmail connect and sync (SF-118). Leave GMAIL_PUBSUB_TOPIC empty with APP_ENV development or test: the app then uses
# its fake Google and Gmail (/dev/fake-google/gmail and the mailbox page /dev/fake-gmail). With a topic, every setting
# below (and GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, APP_URL) must be set, else Settings says "Gmail can't be connected
# right now." (the rest of the app works). See README § Gmail for the Google Cloud setup.
# The Pub/Sub topic Gmail sends its notices to: projects/<project>/topics/<topic>.
GMAIL_PUBSUB_TOPIC=
# Secret (server only): 32 random bytes in base64 (`openssl rand -base64 32`), its own key, never PIPEDRIVE_TOKEN_KEY's
# value. Encrypts the Gmail keys users give the CRM. No built-in value: without it Gmail is off, in development too.
# Changing it makes every user reconnect Gmail. Put it in .env.local or Vercel's settings, never here.
GMAIL_TOKEN_KEY=
# The service account email the Pub/Sub push subscription signs its notices with.
GMAIL_PUSH_SERVICE_ACCOUNT=
# Optional: the audience of the push subscription's token (default: APP_URL/gmail/push).
GMAIL_PUSH_AUDIENCE=
# Optional: projects/<project>/subscriptions/<name>; when set, notices from any other subscription are refused.
GMAIL_PUSH_SUBSCRIPTION=
# Secret (server only), 16 characters or more: Vercel sends it to /cron/gmail as "Authorization: Bearer <secret>".
CRON_SECRET=

# Google Calendar two-way sync (SF-124). on: sync activities with each user's Google Calendar (needs Gmail set up).
# Anything else: off. See README § Google Calendar for the Google Cloud setup.
CALENDAR_SYNC=on

# VERCEL_ENV is set by Vercel (production | preview | development). Do not set it locally.
